diff --git a/e2sim/src/DEF/e2sim_defs.h b/e2sim/src/DEF/e2sim_defs.h
--- a/e2sim/src/DEF/e2sim_defs.h
+++ b/e2sim/src/DEF/e2sim_defs.h
@@ -29,7 +29,7 @@
 #define X2AP_PPID           (452984832) //27 = 1b, PPID = 1b000000(hex) -> 452984832(dec)
 #define X2AP_SCTP_PORT      36421
 #define RIC_SCTP_SRC_PORT   38472
-#define MAX_SCTP_BUFFER     10000
+#define MAX_SCTP_BUFFER     32768 // FlexRIC's E2AP endpoint receives up to 32 KiB per message
 #define WORKDIR_ENV         "E2SIM_DIR" //environment variable
 
 
diff --git a/e2sim/src/base/e2sim.cpp b/e2sim/src/base/e2sim.cpp
--- a/e2sim/src/base/e2sim.cpp
+++ b/e2sim/src/base/e2sim.cpp
@@ -109,7 +109,14 @@
   }
 
   data.len = e2ap_asn1c_encode_pdu(pdu, &buf);
-  memcpy(data.buffer, buf, min(data.len, MAX_SCTP_BUFFER));
+  if (data.len > MAX_SCTP_BUFFER) {
+    // used to send data.len bytes from the MAX_SCTP_BUFFER-sized buffer (stack over-read)
+    LOG_E("E2AP PDU of %d bytes exceeds MAX_SCTP_BUFFER (%d), dropping PDU", data.len, MAX_SCTP_BUFFER);
+    free(buf);
+    return;
+  }
+  memcpy(data.buffer, buf, data.len);
+  free(buf);
 
   LOG_I("Send data to client_fd %d", client_fd)
   sctp_send_data(client_fd, data);
diff --git a/e2sim/src/encoding/encode_e2apv1.cpp b/e2sim/src/encoding/encode_e2apv1.cpp
--- a/e2sim/src/encoding/encode_e2apv1.cpp
+++ b/e2sim/src/encoding/encode_e2apv1.cpp
@@ -827,7 +827,9 @@
     ricind_ies6->value.choice.RICindicationHeader.size = header_length;
     memcpy(ricind_ies6->value.choice.RICindicationHeader.buf, ind_header_buf, header_length);
 
-    ricind_ies7->value.choice.RICindicationMessage.buf = (uint8_t *) calloc(1, 8192);
+    // sized to the message: a fixed 8192 overflowed the heap for larger KPM messages (e.g. a DU
+    // report of 10 UEs in one cell), aborting the host with "malloc(): invalid size"
+    ricind_ies7->value.choice.RICindicationMessage.buf = (uint8_t *) calloc(1, message_length);
 
     ricind_ies7->id = ProtocolIE_ID_id_RICindicationMessage;
 
