diff --git a/model/ric-control-message.cc b/model/ric-control-message.cc
index d13a7d8..32b05ef 100644
--- a/model/ric-control-message.cc
+++ b/model/ric-control-message.cc
@@ -286,9 +286,14 @@ uint16_t RicControlMessage::GetTargetCell() const
 
               BIT_STRING_t NR_CGI = pram1_item4_NR_CGI.ranParameter_valueType->choice.ranP_Choice_ElementFalse->ranParameter_value->choice.valueBitS;
                
-            uint8_t nr_cgi_value;
-            memcpy(&nr_cgi_value, NR_CGI.buf,NR_CGI.size);          
-            uint16_t targetCellId = nr_cgi_value - 48 ;  //convert from string to decimal
+            // ns-O-RAN convention: the "NR CGI" carries the cell id as a decimal ASCII string
+            // ("2", "12"). It used to be read as one ASCII digit (cells 1-9 only), and a longer
+            // string overflowed the 1-byte variable it was copied into.
+            uint16_t targetCellId = 0;
+            for (size_t i = 0; i < NR_CGI.size && NR_CGI.buf[i] >= '0' && NR_CGI.buf[i] <= '9'; i++)
+              {
+                targetCellId = targetCellId * 10 + (NR_CGI.buf[i] - '0');
+              }
             return targetCellId ;
         }    
 
