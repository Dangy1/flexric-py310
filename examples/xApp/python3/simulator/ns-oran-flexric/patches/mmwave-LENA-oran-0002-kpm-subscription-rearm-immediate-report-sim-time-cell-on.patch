+void
+LteEnbNetDevice::ArmKpmReporting (E2Termination::RicSubscriptionRequest_rval_s params)
+{
+  // Only one subscription per node is served: drop the chain of the previous one
+  m_reportEvent.Cancel ();
+  m_stopSendingMessages = false;
+  m_isReportingEnabled = true;
+  BuildAndSendReportMessage (params);
+}
+
+void
+LteEnbNetDevice::DisarmKpmReporting ()
+{
+  m_reportEvent.Cancel ();
+  m_isReportingEnabled = false;
+}
+
 void
 LteEnbNetDevice::stopSendingAndCancelSchedule ()
 {
+  // RIC-SUBSCRIPTION-DELETE (e2sim thread): ignore deletes of subscriptions this node does not
+  // serve; otherwise stop at once and cancel the chain on the simulator thread
+  long requestorId, instanceId;
+  m_e2term->GetDeletingRequestId (requestorId, instanceId);
+  if (!m_hasServedSubscription ||
+      (requestorId >= 0 && (requestorId != m_servedSubscription.requestorId ||
+                            instanceId != m_servedSubscription.instanceId)))
+    {
+      NS_LOG_UNCOND ("Cell " << m_cellId << ": RIC-SUBSCRIPTION-DELETE " << requestorId << "/"
+                     << instanceId << " is not the served subscription, reporting continues");
+      return;
+    }
+  m_hasServedSubscription = false;
+  NS_LOG_UNCOND ("Cell " << m_cellId << ": KPM subscription " << requestorId << "/" << instanceId
+                 << " deleted, reporting stopped");
   m_stopSendingMessages = true;
+  Simulator::ScheduleWithContext (1, Seconds (0), &LteEnbNetDevice::DisarmKpmReporting, this);
 }
 
