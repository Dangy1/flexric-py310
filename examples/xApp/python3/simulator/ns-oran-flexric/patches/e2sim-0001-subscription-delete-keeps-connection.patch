diff --git a/e2sim/src/SCTP/e2sim_sctp.cpp b/e2sim/src/SCTP/e2sim_sctp.cpp
index 7be6ce4..c4a5d7b 100644
--- a/e2sim/src/SCTP/e2sim_sctp.cpp
+++ b/e2sim/src/SCTP/e2sim_sctp.cpp
@@ -233,12 +233,14 @@ int sctp_send_data(int &socket_fd, sctp_buffer_t &data)
 {
   LOG_D("in sctp send data func\n");
   LOG_D("data.len is %d", data.len);
-  int sent_len = send(socket_fd, data.buffer, data.len, 0);
+  // MSG_NOSIGNAL: a peer that went away must not SIGPIPE the host process (ns-3)
+  int sent_len = send(socket_fd, data.buffer, data.len, MSG_NOSIGNAL);
   LOG_D("after getting sent_len\n");
 
   if(sent_len == -1) {
+    // Never terminate the host process from the library; the caller drops the PDU
     LOG_E("[SCTP] sctp_send_data, error message: %s", strerror(errno));
-    exit(EXIT_FAILURE);
+    return -1;
   }
 
   return sent_len;
@@ -286,6 +288,7 @@ int sctp_receive_data(int &socket_fd, sctp_buffer_t &data)
     {
       LOG_E("[SCTP] close, error message: %s", strerror(errno));
     }
+    socket_fd = -1;   // later sends are dropped instead of writing to a stale fd
     return -1;
   }
 
