+// Delay to the next E2 report slot: 1 ns before the next BuildGUIDu tick, after which the
+// trace loggers reset the shared counters (see BuildRicIndicationMessageCuUp)
+Time
+MmWaveEnbNetDevice::E2ReportDelay () const
+{
+  Time slot = m_nextDuLogTime - NanoSeconds (1);
+  while (slot <= Simulator::Now ())
+    {
+      slot += MilliSeconds (100);
+    }
+  return slot - Simulator::Now ();
+}
