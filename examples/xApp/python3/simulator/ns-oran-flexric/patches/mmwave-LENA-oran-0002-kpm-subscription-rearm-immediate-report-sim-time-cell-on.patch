+
+void
+MmWaveEnbNetDevice::ArmKpmReporting(E2Termination::RicSubscriptionRequest_rval_s params,
+                                    bool startNow)
+{
+  NS_LOG_FUNCTION(this << startNow);
+  // Drop the chains of a previous subscription (only one subscription per node is served)
+  m_checkEvent.Cancel();
+  m_reportEvent.Cancel();
+  m_lastSubscriptionParams = params;
+  m_hasValidSubscription = true;
+  m_stopSendingMessages = false;
+  m_isReportingEnabled = false;
+  m_is_reported = false;
+  m_prbHistory.clear();
+
+  if (startNow)
+  {
+    NS_LOG_DEBUG("Cell " << m_cellId << ": KPM reporting starts now");
+    m_is_reported = true;
+    m_isReportingEnabled = true;
+    BuildAndSendReportMessage(m_lastSubscriptionParams);
+  }
+  else
+  {
+    m_checkEvent = Simulator::Schedule(m_checkPeriod, &MmWaveEnbNetDevice::CheckReportingFlag, this);
+    NS_LOG_DEBUG("Started PRB monitoring with period " << m_checkPeriod.GetMilliSeconds() << "ms");
+  }
+}
+
+void
+MmWaveEnbNetDevice::DisarmKpmReporting()
+{
+  NS_LOG_FUNCTION(this);
+  m_checkEvent.Cancel();
+  m_reportEvent.Cancel();
+  m_isReportingEnabled = false;
+  m_is_reported = false;
+  m_hasValidSubscription = false;
 }
 
 void
 MmWaveEnbNetDevice::stopSendingAndCancelSchedule ()
 {
+  // RIC-SUBSCRIPTION-DELETE (e2sim thread). A delete of a subscription this node does not serve
+  // is only acknowledged. Otherwise stop at once and cancel the event chains on the simulator
+  // thread; a later subscription re-arms reporting (ArmKpmReporting).
+  long requestorId, instanceId;
+  m_e2term->GetDeletingRequestId (requestorId, instanceId);
+  if (!m_hasServedSubscription ||
+      (requestorId >= 0 && (requestorId != m_servedSubscription.requestorId ||
+                            instanceId != m_servedSubscription.instanceId)))
+    {
+      NS_LOG_UNCOND ("Cell " << m_cellId << ": RIC-SUBSCRIPTION-DELETE " << requestorId << "/"
+                     << instanceId << " is not the served subscription, reporting continues");
+      return;
+    }
+  m_hasServedSubscription = false;
+  NS_LOG_UNCOND ("Cell " << m_cellId << ": KPM subscription " << requestorId << "/" << instanceId
+                 << " deleted, reporting stopped");
   m_stopSendingMessages = true;
+  Simulator::ScheduleWithContext(1, Seconds(0), &MmWaveEnbNetDevice::DisarmKpmReporting, this);
 }
 
