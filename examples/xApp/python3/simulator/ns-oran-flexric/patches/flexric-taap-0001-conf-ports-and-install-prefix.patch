diff --git a/src/util/conf_file.c b/src/util/conf_file.c
index 3a930e9a..48404fdc 100644
--- a/src/util/conf_file.c
+++ b/src/util/conf_file.c
@@ -18,11 +18,15 @@
 
 #include "alg_ds/alg/defer.h"
 
+#ifndef FLEXRIC_INSTALL_PREFIX
+#define FLEXRIC_INSTALL_PREFIX "/usr/local"
+#endif
+
 static
-const char* default_conf_file = "/usr/local/etc/flexric/flexric.conf";
+const char* default_conf_file = FLEXRIC_INSTALL_PREFIX "/etc/flexric/flexric.conf";
 
 static
-const char* default_libs_dir = "/usr/local/lib/flexric/";
+const char* default_libs_dir = FLEXRIC_INSTALL_PREFIX "/lib/flexric/";
 
 /*
 #include <assert.h>
@@ -561,3 +565,35 @@ char* get_conf_db_name(fr_args_t const* args)
 
   return strdup(db_name);
 }
+
+int get_conf_port(fr_args_t const* args, const char* key, int def)
+{
+  assert(args != NULL);
+  assert(key != NULL);
+
+  FILE* fp = fopen(args->conf_file, "r");
+  if(fp == NULL)
+    return def;
+
+  char* line = NULL;
+  size_t len = 0;
+  int port = def;
+  while(getline(&line, &len, fp) != -1){
+    char* ans = ltrim(line);
+    if(strncmp(ans, key, strlen(key)) != 0)
+      continue;
+    ans += strlen(key);
+    ans = ltrim(ans);
+    if(*ans != '=')
+      continue;
+    ans = rtrim(ltrim(ans + 1));
+    int const p = atoi(ans);
+    if(p > 0 && p < 65536)
+      port = p;
+    break;
+  }
+
+  free(line);
+  fclose(fp);
+  return port;
+}
