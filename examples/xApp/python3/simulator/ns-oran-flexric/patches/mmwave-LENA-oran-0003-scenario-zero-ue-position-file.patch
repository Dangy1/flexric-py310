+    "t=0 is unchanged (random walk)",
+    ns3::StringValue (""), ns3::MakeStringChecker ());
+
+// Read the uePositionFile: returns one position per UE, in UE index (IMSI-1) order
+static std::vector<Vector>
+ReadUePositionFile (const std::string &path, uint32_t nUes, double maxX, double maxY)
+{
+  std::ifstream in (path);
+  if (!in.is_open ())
+    {
+      NS_FATAL_ERROR ("uePositionFile: cannot open " << path);
+    }
+  std::vector<Vector> pos (nUes);
+  std::vector<bool> seen (nUes, false);
+  int indexOffset = 0; // 0: column 1 is ue_index; 1: column 1 is the IMSI
+  std::string line;
+  uint32_t lineNo = 0;
+  while (std::getline (in, line))
+    {
+      ++lineNo;
+      if (!line.empty () && line.back () == '\r')
+        line.pop_back ();
+      if (line.empty () || line[0] == '#')
+        continue;
+      std::vector<std::string> f;
+      std::stringstream ss (line);
+      std::string cell;
+      while (std::getline (ss, cell, ','))
+        f.push_back (cell);
+      if (!f.empty () && !f[0].empty () && !std::isdigit (static_cast<unsigned char> (f[0][0])))
+        {
+          // header row
+          indexOffset = (f[0] == "imsi") ? 1 : 0;
+          continue;
+        }
+      if (f.size () < 3)
+        NS_FATAL_ERROR ("uePositionFile " << path << ":" << lineNo << ": expected ue_index,x,y[,z]");
+      long idx = std::stol (f[0]) - indexOffset;
+      if (idx < 0 || idx >= static_cast<long> (nUes))
+        NS_FATAL_ERROR ("uePositionFile " << path << ":" << lineNo << ": UE " << f[0]
+                                          << " outside 0.." << nUes - 1 + indexOffset);
+      Vector v (std::stod (f[1]), std::stod (f[2]), f.size () > 3 ? std::stod (f[3]) : 0.0);
+      if (v.x < 0 || v.x > maxX || v.y < 0 || v.y > maxY)
+        NS_FATAL_ERROR ("uePositionFile " << path << ":" << lineNo << ": position " << v
+                                          << " outside the mobility bounds 0.." << maxX << " x 0.."
+                                          << maxY);
+      pos[idx] = v;
+      seen[idx] = true;
+    }
+  for (uint32_t i = 0; i < nUes; ++i)
+    {
+      if (!seen[i])
+        NS_FATAL_ERROR ("uePositionFile " << path << ": no position for UE index " << i
+                                          << " (IMSI " << i + 1 << ")");
+    }
+  return pos;
+}
 
